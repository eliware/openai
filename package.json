{
    "name": "@eliware/openai",
    "type": "module",
    "version": "1.1.7",
    "description": "A simple OpenAI API client wrapper for Node.js, with ESM and TypeScript support.",
    "module": "index.mjs",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "examples"
    ],
    "exports": {
        ".": {
            "import": "./index.mjs",
            "types": "./index.d.ts"
        }
    },
    "scripts": {
        "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --coverage",
        "test:gaps": "npm test -- --coverageReporters=text 2>&1 | awk '!/100%/'",
        "lint": "npx oxlint ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/openai.git"
    },
    "keywords": [
        "openai",
        "nodejs",
        "api",
        "client",
        "typescript",
        "esm",
        "ai",
        "eliware"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/openai/issues"
    },
    "homepage": "https://github.com/eliware/openai#readme",
    "devDependencies": {
        "jest": "^30.4.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs",
            "**/?(*.)+(spec|test).cjs"
        ]
    },
    "dependencies": {
        "openai": "^7.4.0",
        "ws": "^8.21.2"
    }
}