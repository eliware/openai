{
    "name": "@eliware/openai",
    "type": "module",
    "version": "2.0.0",
    "description": "A simple OpenAI API client wrapper for Node.js, with ESM and TypeScript support.",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "src",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "examples",
        "RELEASE_NOTES.md",
        "docs",
        "specs"
    ],
    "exports": {
        ".": {
            "import": "./index.mjs",
            "types": "./index.d.ts"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/eliware/openai"
    },
    "keywords": [
        "openai",
        "nodejs",
        "api",
        "client",
        "typescript",
        "esm",
        "ai",
        "eliware"
    ],
    "author": "Eliware <eliware@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/openai/issues"
    },
    "homepage": "https://github.com/eliware/openai#readme",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=26"
    },
    "devDependencies": {
        "@eliware/test": "^4.0.0",
        "typescript": "^7.0.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs",
            "**/?(*.)+(spec|test).cjs"
        ]
    },
    "dependencies": {
        "openai": "^7.8.0",
        "ws": "^8.21.3"
    }
}
